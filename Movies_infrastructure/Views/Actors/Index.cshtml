@model IEnumerable<Movies_infrastructure.ViewModels.ActorListItem>

@{
    ViewData["Title"] = "Актори";
}

<h1>Актори</h1>

<p>
    <a asp-action="Create">Додати новий</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().ActName)
            </th>
            <th>Фільми</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ActName)
            </td>
            <td>
                @if (item.MovieNames != null && item.MovieNames.Any())
                {
                    @string.Join(", ", item.MovieNames)
                }
                else
                {
                    <em>Немає фільмів</em>
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
