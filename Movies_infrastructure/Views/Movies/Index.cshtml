@model IEnumerable<Movies_domain.Model.Movie>

@{
    ViewData["Title"] = ViewBag.GenreId == null ? "Всі фільми" : $"Фільми жанру {ViewBag.GenreName}";
}

@if (ViewBag.GenreId != null)
{
    <h1>Фільми жанру @ViewBag.GenreName</h1>
    <p>
        <a asp-action="Create" asp-route-genreId="@ViewBag.GenreId" asp-route-genreName="@ViewBag.GenreName">Додати новий фільм</a>
    </p>
}
else
{
    <h1>Всі фільми</h1>
}

@if (ViewBag.GenreId == null)
{
    <div class="row mt-4 mb-4">
        <div class="col-6">
            <div id="countByYearChart"></div>
        </div>
        <div class="col-6">
            <div id="countByGenreChart"></div>
        </div>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.MvName)</th>
            <th>@Html.DisplayNameFor(model => model.MvDescription)</th>
            <th>@Html.DisplayNameFor(model => model.MvYear)</th>
            @if (ViewBag.GenreId == null)
            {
                <th>Жанри</th>
            }
            <th>Актори</th>
            <th>Улюблені</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{ var favIds = ViewBag.FavMovieIds as System.Collections.Generic.HashSet<int> ?? new System.Collections.Generic.HashSet<int>(); }
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.MvName)</td>
                <td>@Html.DisplayFor(modelItem => item.MvDescription)</td>
                <td>@Html.DisplayFor(modelItem => item.MvYear)</td>
                @if (ViewBag.GenreId == null)
                {
                    <td>
                        @if (item.Grs != null && item.Grs.Any())
                        {
                            @string.Join(", ", item.Grs.Select(g => g.GrName))
                        }
                        else
                        {
                            <em>Немає жанрів</em>
                        }
                    </td>
                }
                <td>
                    @if (item.Acts != null && item.Acts.Any())
                    {
                        @string.Join(", ", item.Acts.Select(a => a.ActName))
                    }
                    else
                    {
                        <em>Немає акторів</em>
                    }
                </td>
                <td>
                    @if (favIds.Contains(item.Id))
                    {
                        <form asp-action="RemoveFavorite" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", new { id = ViewBag.GenreId, name = ViewBag.GenreName })" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="AddFavorite" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", new { id = ViewBag.GenreId, name = ViewBag.GenreName })" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Додати</button>
                        </form>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script>
        @if (ViewBag.GenreId == null)
        {
            <text>
            google.charts.load('current', { packages: ['corechart'] });
            google.charts.setOnLoadCallback(drawCharts);

            function toNumber(v) {
                if (v === null || v === undefined) return 0;
                var n = Number(v);
                return isNaN(n) ? 0 : n;
            }

            function toString(v) {
                if (v === null || v === undefined) return '';
                return String(v);
            }

            function drawCharts() {
                
                fetch('/api/charts/countByYear')
                    .then(r => r.json())
                    .then(data => {
                        const table = new google.visualization.DataTable();
                        table.addColumn('string', 'рік');
                        table.addColumn('number', 'кількість фільмів');
                        data.forEach(item => {
                            var year = item.year ?? item.Year ?? '';
                            var count = item.count ?? item.Count ?? 0;
                            table.addRow([toString(year), toNumber(count)]);
                        });

                        const chart = new google.visualization.ColumnChart(
                            document.getElementById('countByYearChart'));
                        chart.draw(table, {
                            title: 'Кількість фільмів по рокам',
                            width: 500, height: 350,
                            legend: { position: 'none' }
                        });
                    }).catch(err => console.warn('Error loading countByYear:', err));

                
                fetch('/api/charts/countByGenre')
                    .then(r => r.json())
                    .then(data => {
                        const table = new google.visualization.DataTable();
                        table.addColumn('string', 'жанр');
                        table.addColumn('number', 'кількість фільмів');
                        data.forEach(item => {
                            var genre = item.genre ?? item.Genre ?? '';
                            var count = item.count ?? item.Count ?? 0;
                            table.addRow([toString(genre), toNumber(count)]);
                        });

                        const chart = new google.visualization.PieChart(
                            document.getElementById('countByGenreChart'));
                        chart.draw(table, {
                            title: 'Кількість фільмів по жанрам',
                            width: 500, height: 350
                        });
                    }).catch(err => console.warn('Error loading countByGenre:', err));
            }
            </text>
        }
    </script>
}
