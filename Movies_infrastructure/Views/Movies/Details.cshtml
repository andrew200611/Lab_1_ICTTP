@model Movies_domain.Model.Movie

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MvName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MvName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MvDescription)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MvDescription)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MvYear)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MvYear)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |

    @if (ViewBag.IsFavorite == true)
    {
        <form asp-action="RemoveFavorite" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Movies", new { id = Model.Id })" />
            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити з улюблених</button>
        </form>
    }
    else
    {
        <form asp-action="AddFavorite" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Movies", new { id = Model.Id })" />
            <button type="submit" class="btn btn-sm btn-outline-success">Додати в улюблені</button>
        </form>
    }

    | <a asp-action="Index">Back to List</a>
</div>
