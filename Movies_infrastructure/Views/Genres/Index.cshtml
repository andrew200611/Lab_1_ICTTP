@model IEnumerable<Movies_domain.Model.Genre>

@{
    ViewData["Title"] = "Жанри";
}

<h1>Жанри</h1>

<p>
    <a asp-action="Create">Створити новий</a>

    <a class="btn btn-success mb-3" asp-controller="Genres" asp-action="Import">
        Завантажити з файлу
    </a>
    <a class="btn btn-outline-primary mb-3" asp-controller="Genres" asp-action="Export">
        Експортувати у файл
    </a>

    <form asp-action="ClearDatabase" method="post" style="display:inline;">
        <button type="submit" class="btn btn-danger mb-3" onclick="return confirm('Точно видалити всі дані (фільми, жанри, акторів тощо) з бази?');">
            Очистити всю базу
        </button>
    </form>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.GrName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.GrName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
