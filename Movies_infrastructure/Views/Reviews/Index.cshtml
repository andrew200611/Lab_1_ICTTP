@model IEnumerable<Movies_domain.Model.Review>

@{
    ViewData["Title"] = "Відгуки";
}

<h1>Відгуки до фільму "@ViewBag.MovieName"</h1>

<p>
    <a asp-action="Create" asp-route-id="@ViewBag.MovieId">Додати відгук</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.RwUserNavigation.UsName)</th>
            <th>@Html.DisplayNameFor(model => model.RwDate)</th>
            <th>@Html.DisplayNameFor(model => model.RwText)</th>
            <th>@Html.DisplayNameFor(model => model.RwRate)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.RwUserNavigation.UsName)</td>
                <td>@Html.DisplayFor(modelItem => item.RwDate)</td>
                <td>@Html.DisplayFor(modelItem => item.RwText)</td>
                <td>@Html.DisplayFor(modelItem => item.RwRate)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Редагувати</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>