@model IEnumerable<Movies_domain.Model.User>

@{
    ViewData["Title"] = "Користувачі";
}

<h1>Користувачі</h1>

<p>
    <a asp-action="Create">Створити</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UsEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsRole)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UsEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UsPassword)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UsName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UsRole)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
